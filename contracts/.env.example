# ── Network ──────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# ── Pool Deployment (deploy.js) ──────────────────────────────────────────────
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
PAYOUT_SIGNER_ADDRESSES=0xAddr1,0xAddr2,0xAddr3,0xAddr4,0xAddr5
SIGNATURE_THRESHOLD=3
LABS_WALLET=0xYOUR_LABS_WALLET

# ── Governance Deployment (deploy-all-governance.js) ─────────────────────────
# Set POOL_ADDRESS after deploying ChainFundedPool
POOL_ADDRESS=0xDEPLOYED_POOL_ADDRESS

# Testnet: short delays for fast testing
TIMELOCK_DELAY=60
VOTING_DELAY_BLOCKS=10
VOTING_PERIOD_BLOCKS=50
PROPOSAL_THRESHOLD=1

# ── Etherscan Verification (optional) ────────────────────────────────────────
ETHERSCAN_API_KEY=
