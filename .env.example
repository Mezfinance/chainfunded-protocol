# ── Maintenance Mode ──────────────────────────────────────────────────────────
# Set to "1" in Vercel environment variables to redirect all traffic to /maintenance.html.
# Leave unset (or any value other than "1") for normal operation.
MAINTENANCE_MODE=

# ── ThirdWeb ──────────────────────────────────────────────────────────────────
VITE_THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here

# ── Chain ─────────────────────────────────────────────────────────────────────
# Supported chains:
#   1        = Ethereum Mainnet (production)
#   8453     = Base Mainnet
#   84532    = Base Sepolia
#   11155111 = Sepolia (testnet)
VITE_CHAIN_ID=1
CHAIN_ID=1

# ── Admin Wallets ─────────────────────────────────────────────────────────────
# Comma-separated wallet addresses with admin access
VITE_ADMIN_ADDRESSES=0xYourAdminWalletAddress

# ── Base44 ────────────────────────────────────────────────────────────────────
VITE_BASE44_APP_ID=your_base44_app_id_here
BASE44_APP_ID=your_base44_app_id_here

# ── Smart Contracts ────────────────────────────────────────────────────────────
VITE_REWARDS_POOL_ADDRESS=0xfbdc2592f7d8ae59d1abebb88cf33b2ac70383fc
VITE_LIQUIDITY_POOL_ADDRESS=0xfbdc2592f7d8ae59d1abebb88cf33b2ac70383fc
REWARDS_POOL_ADDRESS=0xfbdc2592f7d8ae59d1abebb88cf33b2ac70383fc

# ── USDC ──────────────────────────────────────────────────────────────────────
# Ethereum Mainnet:  0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# Base Mainnet:      0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
# Base Sepolia:      0x036cbd53842c5426634e7929541ec2318f3dcf7e
# Sepolia testnet:   0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
VITE_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# ── CFG Token Distribution ────────────────────────────────────────────────────
VITE_CFG_TOKEN_ADDRESS=
VITE_CFG_DISTRIBUTOR_ADDRESS=
VITE_CFG_LP_REWARDS_ADDRESS=
# Deployed CFGPresale.sol address — powers the /presale purchase page
VITE_PRESALE_ADDRESS=
# Block CFGPresale was deployed at — start of event indexing (live feed / leaderboard)
VITE_PRESALE_DEPLOY_BLOCK=

# ── Payout Signing ────────────────────────────────────────────────────────────
# Private key of the wallet used as _signer when deploying the contract
# Never commit this value
PAYOUT_SIGNER_KEY=0xYourPayoutSignerPrivateKey

# Private key used by the worker to sign Base44 backend-function calls
# (workerUpdateChallengeAccount, workerCreateTrade, workerUpdateTrade).
# Falls back to PAYOUT_SIGNER_KEY if not set. The corresponding address
# must be configured as WORKER_SIGNER_ADDRESS on each Base44 function.
WORKER_SIGNER_KEY=0xYourWorkerSignerPrivateKey
# Deployed ChainFundedPool address — included in payout signature to prevent cross-deployment replay
CHAINFUNDED_POOL_ADDRESS=0xfbdc2592f7d8ae59d1abebb88cf33b2ac70383fc

# ── MZF Revenue Router ────────────────────────────────────────────────────────
# Deployed MZFRevenueRouter.sol address — set after running scripts/deployRouter.js
VITE_REVENUE_ROUTER_ADDRESS=
# Chain ID of the network the router is deployed on (1 = Ethereum mainnet)
VITE_ROUTER_CHAIN_ID=1
# MZF Gnosis Safe address — owner of the revenue router
MZF_SAFE_ADDRESS=
# MZF treasury wallet — receives swept revenue after distributions
MZF_TREASURY_ADDRESS=

# ── Alpha Vantage (historical volume for FX/Stocks) ──────────────────────────
VITE_ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# ── Chainalysis (OFAC screening — server-side only, NOT VITE_ prefixed) ──────
# Set this in your Base44 function environment variables, not here.
# CHAINALYSIS_API_KEY=your_chainalysis_api_key_here

# ── PostHog Analytics ────────────────────────────────────────────────────────
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── X (Twitter) Pixel — paid campaign conversion tracking ────────────────────
# The pixel is DORMANT until VITE_X_PIXEL_ID is set: no script loads and no
# events fire without it. Find the pixel/tag id and the per-event tag strings
# in X Ads → Tools → Events Manager. Event values are the full tag strings
# (e.g. "tw-oabc1-de234"). Leave an event blank to skip firing it.
VITE_X_PIXEL_ID=
VITE_X_EVENT_PAGEVIEW=
VITE_X_EVENT_CONTENT_VIEW=
VITE_X_EVENT_LEAD=
VITE_X_EVENT_PURCHASE=
VITE_X_EVENT_DEPOSIT=
# Server-side Conversion API (api/x-capi.js). The browser relays each pixel
# conversion to this same-origin endpoint, which forwards it to X with the
# secret token below. It reuses the pixel's event tag + conversion_id (tx
# hash) so pixel and CAPI events de-duplicate. DORMANT until X_PIXEL_TOKEN
# is set. Set X_PIXEL_TOKEN in Vercel env only — NEVER commit it.
X_PIXEL_TOKEN=
X_PIXEL_ID=rcsip
X_ADS_API_VERSION=12

# ── Contract Explorer (api/contract-agent.js) ────────────────────────────────
# Grounded Q&A over the deployed ChainFundedPool source. Reuses ANTHROPIC_API_KEY
# (Claude — set in Vercel env, never commit). No extra config: the public endpoint
# is bounded by built-in per-IP + global request caps and a same-origin check.

# ── Contact form (api/contact.js) ─────────────────────────────────────────────
# The Support → Contact form POSTs to this same-origin endpoint, which emails
# the submission to the support inbox via the Resend HTTP API. DORMANT until
# RESEND_API_KEY is set (the form then tells users to email support@ directly).
# Set RESEND_API_KEY in Vercel env only — NEVER commit it. CONTACT_FROM_EMAIL
# must be a sender on a domain verified in your Resend account.
RESEND_API_KEY=
CONTACT_TO_EMAIL=support@chainfunded.io
CONTACT_FROM_EMAIL=ChainFunded Contact <noreply@chainfunded.io>

# ── RPC ───────────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id

# ── Community auth (worker) ───────────────────────────────────────────────────
# Secret used to HMAC-sign community session JWTs. Set to a long random string.
# Required for community posting / notifications. RPC_URL above is reused to
# verify smart-wallet (EIP-1271) login signatures.
COMMUNITY_JWT_SECRET=
# Domain shown in the sign-in message (optional; defaults to chainfunded.io)
COMMUNITY_AUTH_DOMAIN=chainfunded.io

# ── CFG event indexer (worker) ───────────────────────────────────────────────
# Worker also reads VITE_CFG_DISTRIBUTOR_ADDRESS / VITE_CFG_LP_REWARDS_ADDRESS
# above. CFG_INDEXER_FROM_BLOCK is optional — if absent, indexer scans from
# block 0 (fast on Sepolia; on mainnet set this to the deployment block).
CFG_INDEXER_FROM_BLOCK=

# ── Worker API ────────────────────────────────────────────────────────────────
# Public base URL of the running worker (no trailing slash)
# e.g. https://chainfunded-worker.fly.dev or http://localhost:3001 for local dev
VITE_WORKER_URL=http://localhost:3001
# Port the worker HTTP server listens on (default: 3001)
WORKER_API_PORT=3001
# Restrict CORS to your frontend origin in production (default: *)
# e.g. https://app.chainfunded.io
WORKER_CORS_ORIGIN=*

# ── Price fanout (GET /prices/stream) ────────────────────────────────────────
# Traders read live prices from the worker rather than connecting to an exchange
# themselves, so only the worker's IP is ever seen upstream. All optional.
# How often buffered quotes are flushed to connected clients. Binance can tick
# many times a second per symbol and no terminal needs that, so quotes coalesce.
WORKER_PRICE_FLUSH_MS=250
# Comment frame interval — stops intermediaries closing an idle connection and
# lets clients notice a dead link when markets are quiet.
WORKER_PRICE_HEARTBEAT_MS=20000
# Cap on concurrent streaming clients, to bound memory on the Fly instance.
# Clients beyond this receive {"error":"capacity"} and the socket closes.
WORKER_MAX_PRICE_SUBSCRIBERS=2000

# Historical candles (GET /candles, /stats24h, /daily-opens) are served by the
# worker too — Vercel runs in US regions and binance.com refuses US IPs. The
# chart polls every 2s for the in-progress candle, so responses are cached
# briefly to keep one upstream request serving every viewer.
WORKER_CANDLE_CACHE_MS=5000
# How long a failed candle fetch is remembered. Without this a struggling
# upstream gets a fresh request from every poll of every viewer, exactly when it
# can least afford one.
WORKER_CANDLE_ERROR_TTL_MS=15000
# Request deadline. Generous because the worker may be far from the provider —
# Sydney was timing out against eToro at 15s.
WORKER_CANDLE_TIMEOUT_MS=25000
# Pause between the ~45 sequential requests behind /daily-opens, so a cold-start
# burst doesn't look like an attack and trigger throttling.
WORKER_DAILY_OPEN_GAP_MS=120

# ── Price feeds ───────────────────────────────────────────────────────────────
# Crypto streams from Binance and needs no credentials. FX, commodities and
# stocks stream from eToro's authenticated WebSocket — without these two the
# worker starts but those three asset classes have no prices at all.
# Note the field naming is inverted from how it reads: the long base64
# credential is the USER key, the short opaque one is the API key.
ETORO_USER_KEY=your_etoro_user_key_here
ETORO_API_KEY=your_etoro_api_key_here

# Fill-freshness guard (executors.js#getFreshPrice). Market opens/closes are
# refused when the worker's cached price is stale or the spread is too wide, so
# a trader can't fill against a lagging feed (feed-lag arbitrage). All optional;
# defaults are conservative — tune after monitoring [server] "rejected — stale
# price" logs.
#
# Limits are per asset class because the providers tick at very different rates:
# Binance pushes crypto sub-second, eToro pushes everything else every ~2-5s, so
# one shared limit would either reject every non-crypto fill or let crypto rot.

# Crypto (Binance) — max ms since the last received tick for the symbol.
WORKER_MAX_FILL_AGE_MS=2000
# Crypto — max ms since the provider's own timestamp (clock-skew-tolerant).
WORKER_MAX_FILL_PUBLISH_AGE_MS=3000
# Crypto — max half-spread as bps of price (wide during fast/illiquid moments).
# Replaces the old WORKER_MAX_FILL_CONF_BPS: no exchange or broker publishes a
# Pyth-style confidence interval, so half the live bid/ask spread stands in.
WORKER_MAX_FILL_SPREAD_BPS=25

# FX / commodities / stocks (eToro) — same three checks, looser to match a
# ~5s worst-case tick gap and wider broker quotes.
WORKER_MAX_FILL_AGE_MS_BROKER=12000
WORKER_MAX_FILL_PUBLISH_AGE_MS_BROKER=15000
WORKER_MAX_FILL_SPREAD_BPS_BROKER=60

# ── Discord Bot ───────────────────────────────────────────────────────────────
# Bot token from Discord Developer Portal → Bot tab
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Server (guild) ID — right-click your server with Developer Mode enabled
DISCORD_GUILD_ID=your_discord_guild_id_here
# Channel IDs — right-click each channel with Developer Mode enabled
DISCORD_CHALLENGES_CHANNEL_ID=channel_id_for_challenge_and_phase_events
DISCORD_PAYOUTS_CHANNEL_ID=channel_id_for_payout_events
# Optional: separate channels for daily digest and price alerts
# Falls back to DISCORD_PAYOUTS_CHANNEL_ID if not set
DISCORD_DIGEST_CHANNEL_ID=
DISCORD_ALERTS_CHANNEL_ID=
# Optional: webhook URL to mirror published X posts into a Discord channel.
# Used by scripts/x-bot/post.js. Create via Channel → Edit → Integrations → Webhooks.
DISCORD_TWEET_WEBHOOK_URL=
